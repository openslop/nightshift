# Copy me to nightshift.conf and fill me in. Plain shell. No quotes needed unless there are spaces.

# The repo to work on.
REPO_DIR=$HOME/code/my-app
REPO_SLUG=me/my-app
BASE_BRANCH=main

# Every branch Nightshift makes starts with this.
BRANCH_PREFIX=nightshift

# Your GitHub handle. Jobs read your PR comments to learn what you like.
OWNER=me

# The command that runs your repo's checks. Jobs must make it pass.
CHECKS="npm run lint && npm run typecheck && npm test"

# Jobs to run each night, in order. Remove any you do not want.
# Options: security bugs maintainability performance conventions-followup conventions architecture smoke-tests issues
JOBS="security maintainability performance conventions-followup conventions architecture smoke-tests issues"

# The agent. Nightshift appends the job prompt as the last argument.
# Pick one line and remove the # in front. Flags change often; check `<agent> --help` if a run fails.
AGENT="claude -p --dangerously-skip-permissions --max-turns 150"
# AGENT="codex exec --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check"
# AGENT="agent -p --force"                       # Cursor CLI (older installs: cursor-agent)
# AGENT="gemini --yolo -p"
# AGENT="copilot --allow-all-tools -p"
# AGENT="hermes chat -q"
# AGENT="openclaw agent --local --message"
# AGENT="opencode run"
# AGENT="aider --yes-always --message"
# AGENT="amp -x --dangerously-allow-all"
# AGENT="goose run -t"                           # also set GOOSE_MODE=auto
# AGENT="qwen --yolo -p"
# AGENT="droid exec --auto high"
# AGENT="cline -y"

# If your agent reads the prompt from stdin instead, set this to 1.
AGENT_STDIN=0

# The reviewer. Defaults to AGENT. Set it to use a different agent or model for reviews.
# REVIEW_AGENT="claude -p --dangerously-skip-permissions --max-turns 80"

# How long one job may run.
JOB_TIMEOUT=45m
REVIEW_TIMEOUT=55m

# If the nightly batch starts at or after this hour, it is skipped.
# This stops a batch from running in the middle of your day after your laptop wakes up.
WINDOW_END_HOUR=8

# Where logs, locks, and ledgers live. Outside the repo.
STATE_DIR=$HOME/.local/state/nightshift
