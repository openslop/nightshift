# Settings. Copy me to nightshift.conf and fill me in.
# One setting per line. Use quotes when the value has spaces.

# The repo to work on.
REPO_DIR=$HOME/code/my-app
REPO_SLUG=me/my-app
BASE_BRANCH=main

# Every branch Nightshift makes starts with this.
BRANCH_PREFIX=nightshift

# Your GitHub name. Jobs read what you said on past pull requests to learn your taste.
OWNER=me

# The command that runs your repo's checks. Every job must make it pass before it opens a pull request.
CHECKS="npm run lint && npm run typecheck && npm test"

# The jobs to run each night, in this order. Take out any you do not want.
# Options: security bugs readability maintainability performance conventions-followup conventions architecture smoke-tests issues
JOBS="security readability maintainability performance conventions-followup conventions architecture smoke-tests issues"

# Your coding agent. Pick one line and remove the # in front.
# Nightshift runs this command and adds the job text at the end.
# Every line turns off "are you sure?" prompts. That is needed. No one is awake to answer.
# These flags change now and then. If a run fails, check the agent's help and fix the line.
AGENT="claude -p --dangerously-skip-permissions --max-turns 150"
# AGENT="codex exec --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check"
# AGENT="agent -p --force"                       # Cursor CLI (older installs: cursor-agent)
# AGENT="gemini --yolo -p"
# AGENT="copilot --allow-all-tools -p"
# AGENT="hermes chat -q"
# AGENT="openclaw agent --local --message"
# AGENT="opencode run"
# AGENT="aider --yes-always --message"
# AGENT="amp -x --dangerously-allow-all"
# AGENT="goose run -t"                           # also set GOOSE_MODE=auto
# AGENT="qwen --yolo -p"
# AGENT="droid exec --auto high"
# AGENT="cline -y"

# Some agents want the job text typed in, not added to the command. For those, set this to 1.
AGENT_STDIN=0

# The reviewer. Same as AGENT unless you set it.
# REVIEW_AGENT="claude -p --dangerously-skip-permissions --max-turns 80"

# How long one job may run before it is stopped.
JOB_TIMEOUT=45m
REVIEW_TIMEOUT=55m

# If the night run starts at or after this hour, it is skipped.
# This stops it from running in the middle of your day after your laptop wakes up.
WINDOW_END_HOUR=8

# Where logs and notes go. Outside your repo.
STATE_DIR=$HOME/.local/state/nightshift
